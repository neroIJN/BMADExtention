{
  "name": "bmad-method-visualizer",
  "displayName": "BMAD Visualizer",
  "description": "Visualizer, cockpit, and interactive assistant for the BMad Method",
  "version": "0.1.2",
  "publisher": "neroIJN",
  "repository": {
    "type": "git",
    "url": "https://github.com/neroIJN/BMADExtention.git"
  },
  "homepage": "https://github.com/neroIJN/BMADExtention",
  "bugs": {
    "url": "https://github.com/neroIJN/BMADExtention/issues"
  },
  "icon": "media/icons/bmad-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "bmad",
    "visualizer",
    "workflow",
    "kanban",
    "dashboard"
  ],
  "activationEvents": [
    "onView:bmad.views.lifecycle",
    "onView:bmad.views.agents",
    "onView:bmad.views.sprint",
    "onView:bmad.views.artifacts",
    "onView:bmad.views.welcome"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bmad-explorer",
          "title": "BMAD Method",
          "icon": "media/icons/bmad-icon.svg"
        }
      ]
    },
    "views": {
      "bmad-explorer": [
        {
          "id": "bmad.views.lifecycle",
          "name": "Lifecycle & Workflows",
          "when": "bmad:hasBmadProject"
        },
        {
          "id": "bmad.views.agents",
          "name": "Agents & Personas",
          "when": "bmad:hasBmadProject"
        },
        {
          "id": "bmad.views.sprint",
          "name": "Sprint & Stories",
          "when": "bmad:hasBmadProject"
        },
        {
          "id": "bmad.views.artifacts",
          "name": "Artifacts Explorer",
          "when": "bmad:hasBmadProject"
        },
        {
          "id": "bmad.views.welcome",
          "name": "BMAD Method",
          "when": "!bmad:hasBmadProject"
        }
      ]
    },
    "commands": [
      {
        "command": "bmad.openDashboard",
        "title": "Open Visualizer Dashboard",
        "category": "BMAD"
      },
      {
        "command": "bmad.statusCheck",
        "title": "Check Project Status & Recommendations",
        "category": "BMAD"
      },
      {
        "command": "bmad.runSkill",
        "title": "Run Skill...",
        "category": "BMAD"
      },
      {
        "command": "bmad.talkToAgent",
        "title": "Talk to Agent / Switch Persona...",
        "category": "BMAD"
      },
      {
        "command": "bmad.refreshLifecycle",
        "title": "Refresh Lifecycle & Workflows",
        "category": "BMAD",
        "icon": "$(refresh)"
      },
      {
        "command": "bmad.showRecommendations",
        "title": "Show Recommended Next Skills",
        "category": "BMAD",
        "icon": "$(sparkle)"
      },
      {
        "command": "bmad.runSkillFromTree",
        "title": "Run Skill",
        "category": "BMAD",
        "icon": "$(play)"
      },
      {
        "command": "bmad.openArtifactFromTree",
        "title": "Open Artifact",
        "category": "BMAD",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bmad.inspectAgent",
        "title": "Inspect Agent Persona",
        "category": "BMAD"
      },
      {
        "command": "bmad.talkToAgentFromTree",
        "title": "Talk to Agent",
        "category": "BMAD",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "bmad.refreshAgents",
        "title": "Refresh Agents & Personas",
        "category": "BMAD",
        "icon": "$(refresh)"
      },
      {
        "command": "bmad.refreshWorkspace",
        "title": "Refresh Workspace & Manifests",
        "category": "BMAD",
        "icon": "$(refresh)"
      },
      {
        "command": "bmad.openArtifact",
        "title": "Open Artifact",
        "category": "BMAD",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bmad.refreshArtifacts",
        "title": "Refresh Artifacts Explorer",
        "category": "BMAD",
        "icon": "$(refresh)"
      },
      {
        "command": "bmad.inspectMemlog",
        "title": "Inspect Memlog Decisions & Timeline...",
        "category": "BMAD",
        "icon": "$(history)"
      },
      {
        "command": "bmad.validateDocument",
        "title": "Validate Document against Rubric...",
        "category": "BMAD",
        "icon": "$(checklist)"
      },
      {
        "command": "bmad.openTeaDashboard",
        "title": "Open TEA Quality & Traceability Dashboard",
        "category": "BMAD",
        "icon": "$(beaker)"
      },
      {
        "command": "bmad.switchWorkspaceProject",
        "title": "Switch Active BMAD Project...",
        "category": "BMAD",
        "icon": "$(folder-active)"
      },
      {
        "command": "bmad.refreshSprint",
        "title": "Refresh Sprint & Stories",
        "category": "BMAD",
        "icon": "$(refresh)"
      },
      {
        "command": "bmad.openFolder",
        "title": "Open BMAD Project Folder...",
        "category": "BMAD",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bmad.switchWorkspaceProject",
          "when": "view == bmad.views.lifecycle",
          "group": "navigation@0"
        },
        {
          "command": "bmad.showRecommendations",
          "when": "view == bmad.views.lifecycle",
          "group": "navigation@1"
        },
        {
          "command": "bmad.refreshLifecycle",
          "when": "view == bmad.views.lifecycle",
          "group": "navigation@2"
        },
        {
          "command": "bmad.refreshAgents",
          "when": "view == bmad.views.agents",
          "group": "navigation"
        },
        {
          "command": "bmad.refreshSprint",
          "when": "view == bmad.views.sprint",
          "group": "navigation"
        },
        {
          "command": "bmad.refreshArtifacts",
          "when": "view == bmad.views.artifacts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "bmad.openArtifact",
          "when": "view == bmad.views.artifacts && viewItem == bmadArtifactItem",
          "group": "inline@1"
        },
        {
          "command": "bmad.validateDocument",
          "when": "view == bmad.views.artifacts && viewItem == bmadArtifactItem",
          "group": "inline@2"
        },
        {
          "command": "bmad.runSkillFromTree",
          "when": "view == bmad.views.lifecycle && viewItem == bmadSkill",
          "group": "inline@1"
        },
        {
          "command": "bmad.openArtifactFromTree",
          "when": "view == bmad.views.lifecycle && viewItem == bmadSkill",
          "group": "inline@2"
        },
        {
          "command": "bmad.talkToAgentFromTree",
          "when": "view == bmad.views.agents && viewItem == bmadAgent",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "BMAD Extension",
      "properties": {
        "bmad.autoDetectWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect BMAD installation in workspace."
        },
        "bmad.cliRunner": {
          "type": "string",
          "enum": [
            "terminal",
            "clipboard"
          ],
          "default": "terminal",
          "description": "Execution target for BMAD skills."
        },
        "bmad.refreshDebounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce interval in milliseconds for file system watcher."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "bmad.views.welcome",
        "contents": "No BMAD Method project detected in the active workspace.\n\nOpen a project folder containing a `_bmad/` configuration directory to explore lifecycles, personas, artifacts, and sprint Kanban.\n\n[Open Project Folder](command:bmad.openFolder)\n[Switch Workspace Project](command:bmad.switchWorkspaceProject)\n[Check BMAD Status](command:bmad.statusCheck)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run package:check",
    "compile:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "compile:webview": "vite build",
    "compile": "npm run compile:ext && npm run compile:webview",
    "watch:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "watch:webview": "vite build --watch",
    "build": "npm run compile",
    "package": "npm run package:check && npx @vscode/vsce package --no-dependencies",
    "package:dry-run": "npx @vscode/vsce ls --no-dependencies",
    "package:check": "node scripts/check-package.mjs",
    "package:check:vsix": "node scripts/check-package.mjs --vsix",
    "compile:tests": "tsc -p tsconfig.test.json",
    "pretest:extension-host": "npm run compile && npm run compile:tests",
    "test:extension-host": "node ./dist-test/runTest.js",
    "test": "vitest run"
  },
  "dependencies": {
    "csv-parse": "^5.5.5",
    "js-yaml": "^4.1.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@types/glob": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.2",
    "glob": "^13.0.6",
    "mocha": "^12.0.2",
    "preact": "^10.20.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
